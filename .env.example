# Frontend: use the Supabase project's publishable/anon key, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Browser-accessible FastAPI base URL (no trailing slash required).
# For Render, set this on the Next.js frontend service to the actual FastAPI
# service's HTTPS URL, not the frontend URL. NEXT_PUBLIC_* values are baked in
# at build time, so redeploy the frontend after changing this value.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=lameguard-images

# Server-only shared signing secret: use the same random value for Next.js and FastAPI.
# Never prefix this variable with NEXT_PUBLIC_.
PREDICTION_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# Backend settings (set only in the FastAPI process; inspect and configure actual paths).
# PRIMARY_MODEL_PATH=C:\exact\path\to\primary\best.pt
# BODY_PART_MODEL_PATH=C:\exact\path\to\body-parts\best.pt
# Optional private Supabase Storage bootstrap for deployments without persistent files.
# These credentials are backend-only. Never prefix them with NEXT_PUBLIC_.
# Use a private `lameguard-models` bucket with the two model objects uploaded.
# The service-role key has elevated project access; a dedicated model-storage
# Supabase project limits the impact if that backend-only key is compromised.
# MODEL_STORAGE_SUPABASE_URL=https://your-model-storage-project.supabase.co
# MODEL_STORAGE_SUPABASE_SERVICE_ROLE_KEY=your_backend_only_service_role_key
# MODEL_STORAGE_BUCKET=lameguard-models
# PRIMARY_MODEL_OBJECT_PATH=models/lameness_best.pt
# BODY_PART_MODEL_OBJECT_PATH=models/body_parts_best.pt
# SHA-256 hashes of the exact checkpoint files; update them if replacing weights.
# PRIMARY_MODEL_SHA256=2c16432374dce1f734e394e586dab2d9b39fa5a71f84b8b7365d9e833a8c92d0
# BODY_PART_MODEL_SHA256=7bdb391c05e070c5dd3062808c6801a8c7775d39939a83c2b94c9626f6320daf
# Model names are derived from the loaded checkpoint metadata; versions use a checkpoint SHA-256 fingerprint.
# Optional confidence filtering; no lameness threshold is assumed by default.
# PRIMARY_CONFIDENCE_THRESHOLD=0.5
# BODY_PART_CONFIDENCE_THRESHOLD=0.25
# VIDEO_SAMPLE_INTERVAL_SECONDS=2
# VIDEO_MAX_FRAMES=60
# MAX_VIDEO_DURATION_SECONDS=120
# MAX_VIDEO_BYTES=262144000
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
